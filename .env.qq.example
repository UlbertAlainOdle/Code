# Copy to .env.qq, edit IDs and secrets, then run scripts/start_qq.ps1.
# .env.qq is ignored by Git. Do not use these example tokens in real use.
SAYA_QQ_ENABLED=true
SAYA_QQ_BOT_ID=10000
SAYA_QQ_API_URL=http://127.0.0.1:3000
SAYA_QQ_ACCESS_TOKEN=replace-with-onebot-http-server-token
# NapCat HTTP client's token signs the RAW request body (HMAC-SHA1).
SAYA_QQ_WEBHOOK_SECRET=replace-with-napcat-http-client-token
# Optional bearer ingress for other implementations; leave empty with NapCat.
SAYA_QQ_WEBHOOK_TOKEN=
SAYA_QQ_ADMIN_TOKEN=replace-with-separate-admin-token
SAYA_QQ_ALLOWED_USERS=20000
SAYA_QQ_ALLOWED_GROUPS=
SAYA_QQ_OWNER_IDS=
SAYA_QQ_SHARED_MEMORY=false
SAYA_QQ_GROUP_MENTION_ONLY=true
# Only invitations sent by configured OWNER_IDS can be accepted automatically.
SAYA_QQ_AUTO_ACCEPT_OWNER_INVITES=false
# Fallback for direct joins: the owner's first structural @ can enable a new group.
SAYA_QQ_OWNER_GROUP_AUTO_ENABLE=false
SAYA_QQ_MODEL=auto
SAYA_QQ_COOLDOWN_SECONDS=3
SAYA_QQ_QUEUE_SIZE=32
SAYA_QQ_MAX_EVENT_AGE=300
SAYA_QQ_REPLY_TIMEOUT=180
SAYA_QQ_HISTORY_TURNS=12
SAYA_QQ_RETENTION_DAYS=7
SAYA_QQ_CHUNK_CHARS=1500
SAYA_QQ_MAX_REPLY_CHARS=6000
# Non-secret controls can also be saved in Settings > QQ. Saved UI values take precedence.
SAYA_QQ_THINKING_EFFORT=auto
SAYA_QQ_AGENT_MODE=false
SAYA_QQ_RECALL_MODE=auto
SAYA_QQ_RECALL_MEMORY_COUNT=30
SAYA_QQ_MEMORY_TOKEN_BUDGET=12000
SAYA_QQ_GRAPH_RECALL_MODE=auto
SAYA_QQ_MEMORY_WRITE_ENABLED=true
SAYA_QQ_WEB_SEARCH_MODE=off
SAYA_QQ_MAX_OUTPUT_TOKENS=8192
# Optional: set startup model to api to avoid loading a local GGUF model.
# SAYA_STARTUP_MODEL=api
# API_KEY=your-provider-key
# API_URL=https://your-provider.example/v1
# API_MODEL=your-model
